# Constellation 25 — Quick Launch Command
# Type 'C25' to launch the TUI dashboard
C25() {
  if [ -f ~/c25-launch.sh ]; then
    bash ~/c25-launch.sh
  else
    echo "⚠ C25 launcher not found. Creating..."
    mkdir -p ~/constellation-25-live
    tar -xzf ~/Constellation25-v3.0-DEPLOY.tar.gz -C ~/constellation-25-live --strip-components=1 2>/dev/null || true
    bash ~/c25-launch.sh
  fi
}

