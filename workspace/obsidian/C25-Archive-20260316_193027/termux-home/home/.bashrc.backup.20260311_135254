# C25 AUTO-PARSE: Paste conversation, run c25-run, get bash
c25-run() {
  local tmp="$HOME/.c25_tmp_$$"
  cat > "$tmp"
  grep -E "^(cd |mkdir |echo |for |chmod |find |ls |cat |rm |cp |mv |source |export |alias|# )" "$tmp" 2>/dev/null | sed 's/^#\s*//' | bash
  rm -f "$tmp"
}
